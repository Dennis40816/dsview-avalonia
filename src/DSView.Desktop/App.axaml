<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DSView.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="fonts:Inter#Inter" /><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="#101820" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="30" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#78D7C8" /><Setter Property="Foreground" Value="#101820" /></Style>
    <Style Selector="Button.flat"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="380" /></Style>
  </Application.Styles>
</Application>
