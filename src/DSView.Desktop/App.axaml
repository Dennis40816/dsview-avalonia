<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DSView.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="fonts:Inter#Inter" /><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" /><Setter Property="Background" Value="#101820" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#78D7C8" /><Setter Property="Foreground" Value="#101820" /></Style>
    <Style Selector="Button.flat"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="#657887" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="Background" Value="#0E1720" /><Setter Property="BorderBrush" Value="#40515F" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="Background" Value="#1C2A35" /><Setter Property="BorderBrush" Value="#40515F" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,10" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="Button.tab"><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="380" /></Style>
    <Style Selector="FlyoutPresenter.analysis"><Setter Property="MaxWidth" Value="640" /><Setter Property="Background" Value="#18242E" /><Setter Property="Padding" Value="12" /><Setter Property="BorderBrush" Value="#34444F" /></Style>
  </Application.Styles>
</Application>
