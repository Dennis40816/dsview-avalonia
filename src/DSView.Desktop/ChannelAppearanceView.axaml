<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DSView.Desktop" x:Class="DSView.Desktop.ChannelAppearanceView"
             x:DataType="local:ChannelAppearanceViewModel" x:CompileBindings="True" Width="300">
  <StackPanel Spacing="14" Margin="6">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
      <Button Grid.Column="1" Classes="flat" Command="{Binding CancelCommand}" ToolTip.Tip="Close channel appearance" AutomationProperties.Name="Close channel appearance" Width="32" Padding="8">
        <Path Data="M3,3 L13,13 M13,3 L3,13" Width="16" Height="16" Stretch="Uniform" Stroke="#C7D2DB" StrokeThickness="1.6" />
      </Button>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border Background="{Binding ProbeBrush}" Width="5" Height="18" />
      <TextBlock Text="Physical probe" Foreground="#9BAEBF" />
    </StackPanel>
    <Separator />
    <TextBlock Text="Waveform color" />
    <Border Background="#101820" Padding="14,12">
      <Path Data="M0,24 L30,24 L30,4 L70,4 L70,24 L110,24 L110,4 L150,4 L150,24 L190,24 L190,4 L230,4" Height="28" Stretch="Fill" Stroke="{Binding PreviewBrush}" StrokeThickness="2" />
    </Border>
    <UniformGrid Columns="6">
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#D4AD00" Background="#D4AD00" ToolTip.Tip="Yellow" AutomationProperties.Name="Yellow waveform" Margin="0,0,6,0" Padding="0" />
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#78D7C8" Background="#78D7C8" ToolTip.Tip="Mint" AutomationProperties.Name="Mint waveform" Margin="0,0,6,0" Padding="0" />
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#8BB7FF" Background="#8BB7FF" ToolTip.Tip="Blue" AutomationProperties.Name="Blue waveform" Margin="0,0,6,0" Padding="0" />
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#E58C8C" Background="#E58C8C" ToolTip.Tip="Rose" AutomationProperties.Name="Rose waveform" Margin="0,0,6,0" Padding="0" />
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#B7A0EB" Background="#B7A0EB" ToolTip.Tip="Violet" AutomationProperties.Name="Violet waveform" Margin="0,0,6,0" Padding="0" />
      <Button Command="{Binding SelectColorCommand}" CommandParameter="#C7D2DB" Background="#C7D2DB" ToolTip.Tip="Silver" AutomationProperties.Name="Silver waveform" Padding="0" />
    </UniformGrid>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <TextBlock Text="Hex" Foreground="#9BAEBF" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding ColorText, Mode=TwoWay}" MaxLength="9" AutomationProperties.Name="Waveform color hex value" />
    </Grid>
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF9AAA" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <Button Content="Default" Classes="flat" Command="{Binding DefaultCommand}" HorizontalAlignment="Left" />
      <Button Grid.Column="1" Content="Cancel" Classes="flat" Command="{Binding CancelCommand}" />
      <Button Grid.Column="2" Content="Apply" Classes="primary" Command="{Binding ApplyCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
